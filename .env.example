# OpenScroll Configuration
NEXT_PUBLIC_APP_ENV=local

# OpenAI is the sole provider for topic generation and entity resolution.
# Requests fail when this configuration is missing or OpenAI is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional aggregate feed telemetry in server logs (no terms, payloads, or secrets).
FEED_METRICS_LOG=0
