# OpenScroll Configuration
NEXT_PUBLIC_APP_ENV=local

# OpenAI is the provider for topic generation, entity resolution, and relevance evaluation.
# Requests fail when this configuration is missing or OpenAI is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_GENERATION_MODEL=gpt-6-luna
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_DECISION_THRESHOLD=0.7

# Optional aggregate feed telemetry in server logs (no terms, payloads, or secrets).
FEED_METRICS_LOG=0

