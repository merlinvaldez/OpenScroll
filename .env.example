# OpenScroll Configuration
NEXT_PUBLIC_APP_ENV=local

# OpenAI remains the provider for topic generation and entity resolution.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Jev feed evaluation runs through Vercel AI Gateway.
# Vercel deployments use OIDC; local development can use an AI Gateway key.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_RELEVANCE_THRESHOLD=0.75
